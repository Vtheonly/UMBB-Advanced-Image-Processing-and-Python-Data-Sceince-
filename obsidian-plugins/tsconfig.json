{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2018",
    "lib": ["DOM", "ES2018", "ES2019", "ES2020", "ES2021"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "focus-read-suite/src/**/*.ts",
    "legacy/*/src/**/*.ts",
    "legacy/shared/src/**/*.ts"
  ],
  "exclude": ["node_modules", "*/dist/**", "**/test/**"]
}
